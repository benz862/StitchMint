# Public
# Must be a valid absolute URL (include http:// or https://) or Safari can throw "The string did not match the expected pattern."
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Project URL only: https://xxxx.supabase.co — no trailing slash, no /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Magic-link sign-in: emails are sent by Supabase (not Resend). In Dashboard → Authentication → URL configuration:
# set Site URL to your live app and add https://YOUR_DOMAIN/auth/callback to Redirect URLs (and preview URLs if needed).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Workshop/demo: full Payment Link URL — Unlock uses it for every tier (skips API Checkout / webhook patternId). Production: omit or set false for real checkout.
# NEXT_PUBLIC_DEMO_BASIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_fZu4gz2k77jD7o94zp8Vi01
# Gumroad checkout (Basic, Premium, Pro). Set NEXT_PUBLIC_GUMROAD_CHECKOUT=false to force Stripe for all tiers.
# NEXT_PUBLIC_GUMROAD_URL_BASIC=https://skillbinder.gumroad.com/l/xhcfx
# NEXT_PUBLIC_GUMROAD_URL_PLUS=https://skillbinder.gumroad.com/l/quumdh
# NEXT_PUBLIC_GUMROAD_URL_PRO=https://skillbinder.gumroad.com/l/whhlqy
# Required in production: signs checkout URLs (`st=`) so buyers cannot edit pattern id on Gumroad. Generate: openssl rand -base64 32
# GUMROAD_CHECKOUT_SIGNING_SECRET=
# Legacy only if signing secret unset: custom field name on Gumroad (avoid — field is editable). Prefer removing the field and using `st` only.
# GUMROAD_PATTERN_FIELD=pattern_id
# Gumroad → Settings → Advanced → Ping: https://YOUR_DOMAIN/api/webhooks/gumroad (alias: /api/gumroadping)
# Gumroad Checkout form: remove the visible pattern_id field; StitchMint passes a signed `st` token in the unlock link.
# Shown in the site footer (mailto) and on pattern PDFs (defaults to support@skillbinder.com if unset).
NEXT_PUBLIC_SUPPORT_EMAIL=support@skillbinder.com

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
# Live webhook URL (Stripe → Developers → Webhooks): https://YOUR_DOMAIN/api/webhooks/stripe
# Legacy alias also works: https://YOUR_DOMAIN/api/stripewebhook (same handler).
STRIPE_WEBHOOK_SECRET=

# Tiered Stripe Price IDs — pattern_basic / pattern_premium / pattern_pro (optional: defaults in src/config/pricing.ts).
# Legacy env names STRIPE_PRICE_ID_STARTER / STRIPE_PRICE_ID_PREMIUM still work as fallbacks for basic / pro.
# STRIPE_PRICE_ID_BASIC=price_1TSGhUE6oTidvpnU40GWWPJL
# STRIPE_PRICE_ID_PLUS=price_1TSGhVE6oTidvpnUteD7W8U7
# STRIPE_PRICE_ID_PRO=price_1TSGhVE6oTidvpnUNpKFwbU2
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PLUS=
STRIPE_PRICE_ID_PRO=

# Legacy: if all tier vars are unset, one STRIPE_PRICE_ID is used for every checkout.
# STRIPE_PRICE_ID=

# Optional: absolute path to raster cover for Pattern-*.pdf page 1 (Letter). If unset, uses public/StitchMint_Pattern_Template.jpg when present, else pattern-cover-bg.*.
# STITCHMINT_COVER_BG_PATH=

# Comma-separated admin emails for /admin and admin APIs
ADMIN_EMAILS=you@yourdomain.com

# Optional: Resend — outbound only: "From" when the app sends mail (must use a domain you verified in Resend).
# Not the same as NEXT_PUBLIC_SUPPORT_EMAIL. You do not need RESEND_FROM to show support in the footer.
# Name must be exactly RESEND_API_KEY (Resend + Vercel docs). Not NEXT_PUBLIC_. Set for Production/Preview as needed; redeploy after changes.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=StitchMint <orders@stitchmint.app>
