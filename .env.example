# Public
# Must be a valid absolute URL (include http:// or https://) or Safari can throw "The string did not match the expected pattern."
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Project URL only: https://xxxx.supabase.co — no trailing slash, no /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Workshop/demo: full Payment Link URL — Unlock uses it for every tier (skips API Checkout / webhook patternId). Production: omit or set false for real checkout.
# NEXT_PUBLIC_DEMO_BASIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_fZu4gz2k77jD7o94zp8Vi01
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tiered Stripe Price IDs — pattern_basic / pattern_premium / pattern_pro (optional: defaults in src/config/pricing.ts).
# Legacy env names STRIPE_PRICE_ID_STARTER / STRIPE_PRICE_ID_PREMIUM still work as fallbacks for basic / pro.
# STRIPE_PRICE_ID_BASIC=price_1TSGhUE6oTidvpnU40GWWPJL
# STRIPE_PRICE_ID_PLUS=price_1TSGhVE6oTidvpnUteD7W8U7
# STRIPE_PRICE_ID_PRO=price_1TSGhVE6oTidvpnUNpKFwbU2
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PLUS=
STRIPE_PRICE_ID_PRO=

# Legacy: if all tier vars are unset, one STRIPE_PRICE_ID is used for every checkout.
# STRIPE_PRICE_ID=

# Optional: absolute path to raster cover for Pattern-*.pdf page 1 (Letter). If unset, uses public/StitchMint_Pattern_Template.jpg when present, else pattern-cover-bg.*.
# STITCHMINT_COVER_BG_PATH=

# Comma-separated admin emails for /admin and admin APIs
ADMIN_EMAILS=you@yourdomain.com

# Optional: Resend — admin “Tier sample pack” can email the ZIP to the signed-in admin; /admin → “Send test email to me” checks config
# RESEND_API_KEY=re_...
# RESEND_FROM=StitchMint <orders@stitchmint.app>
