# Public
# Must be a valid absolute URL (include http:// or https://) or Safari can throw "The string did not match the expected pattern."
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Project URL only: https://xxxx.supabase.co — no trailing slash, no /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# One-time Price ID from Stripe Dashboard (Products → StitchMint → add price). Overrides PATTERN_PRICE_CENTS when set.
STRIPE_PRICE_ID=
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Used only if STRIPE_PRICE_ID is unset (ad-hoc Checkout line item).
PATTERN_PRICE_CENTS=995
# Optional: shown on the home page pricing card (does not change what Stripe charges unless STRIPE_PRICE_ID unset).
NEXT_PUBLIC_PATTERN_PRICE_LABEL=9.95

# Comma-separated admin emails for /admin and admin APIs
ADMIN_EMAILS=you@yourdomain.com
